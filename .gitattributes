# Line endings per file type, whatever OS does the checkout.
*.py        text eol=lf
*.sh        text eol=lf
*.command   text eol=lf
*.md        text eol=lf
*.txt       text eol=lf
*.yml       text eol=lf
*.plist     text eol=lf
*.bat       text eol=crlf
*.vbs       text eol=crlf
**/Contents/MacOS/launcher  text eol=lf
*.png  binary
*.icns binary
*.ico  binary
