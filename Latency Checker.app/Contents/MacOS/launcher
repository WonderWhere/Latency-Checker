#!/bin/bash
# Opens the Latency Checker viewer with no Terminal window.
# Uses the project folder this .app sits in (keep the .app next to latency_viewer.py).
DIR="$(cd "$(dirname "$0")/../../.." && pwd)"
cd "$DIR" || exit 1
export PATH="/Library/Frameworks/Python.framework/Versions/Current/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"
LOGDIR="$HOME/LatencyChecker"; mkdir -p "$LOGDIR"; LOG="$LOGDIR/viewer-launch.log"
alert() { osascript -e "display alert \"Latency Checker\" message \"$1\"" >/dev/null 2>&1; }
if [ ! -f latency_viewer.py ]; then
  alert "Keep Latency Checker.app in the same folder as latency_viewer.py."; exit 1
fi
if [ ! -x .venv/bin/python ]; then
  osascript -e 'display notification "Setting up Python packages (first run, about a minute)…" with title "Latency Checker"' >/dev/null 2>&1
  python3 -m venv .venv >>"$LOG" 2>&1 || { alert "Python 3 is required. Install it from python.org, then try again."; exit 1; }
fi
if [ ! -f .venv/.deps-ok ] || [ requirements.txt -nt .venv/.deps-ok ]; then
  .venv/bin/pip install -q --disable-pip-version-check -r requirements.txt >>"$LOG" 2>&1 \
    && touch .venv/.deps-ok \
    || { alert "Installing packages failed. See ~/LatencyChecker/viewer-launch.log"; exit 1; }
fi
exec .venv/bin/python latency_viewer.py >>"$LOG" 2>&1
